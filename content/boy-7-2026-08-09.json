{"animal":[{"level":"1","type":"animal","question":"Mul on neli jalga ja saba. Ma armastan mängida ja haugun \"auh-auh!\". Kes ma olen?","hints":[{"text":"🤔 Ma olen inimese parim sõber."},{"text":"👀 Mulle meeldib luid närida."},{"text":"🏃 Ma toon sulle palli tagasi."}],"options":[{"label":"Kass","isCorrect":false},{"label":"Koer","isCorrect":true},{"label":"Lõvi","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF4CAF50","category":"animal","icon":"🐾"}},{"level":"2","type":"animal","question":"Mul on pikk nina, mis on ka käsi, ja suured kõrvad. Elan soojal maal. Kes ma olen?","hints":[{"text":"🌳 Ma olen suurim maismaaloom."},{"text":"💧 Mulle meeldib end mudaga jahutada."},{"text":"👨‍👩‍👧 Mu lapsed on vasikad."}],"options":[{"label":"Kaamel","isCorrect":false},{"label":"Elevand","isCorrect":true},{"label":"Hobune","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFFFEB3B","category":"animal","icon":"🐾"}},{"level":"3","type":"animal","question":"Ma elan puude otsas, mulle meeldib banaanid ja ma oskan turnida. Kes ma olen?","hints":[{"text":"🤔 Ma olen tuntud oma naljaka käitumise poolest."},{"text":"🌴 Elan džunglis."},{"text":"😋 Mulle meeldib koorida oma lemmikvilja."}],"options":[{"label":"Jänes","isCorrect":false},{"label":"Orav","isCorrect":false},{"label":"Ahv","isCorrect":true}],"additionalData":{"backgroundColor":"0xFF2196F3","category":"animal","icon":"🐾"}},{"level":"4","type":"animal","question":"Mul on uhke lakk ja ma möirgan valjult. Mõnikord kutsutakse mind džungli kuningaks. Kes ma olen?","hints":[{"text":"🐾 Ma olen kasside sugulane."},{"text":"☀️ Elan Aafrika savannides."},{"text":"🧐 Mu pea ümber on karvane krae."}],"options":[{"label":"Tiiger","isCorrect":false},{"label":"Lõvi","isCorrect":true},{"label":"Hunt","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFE91E63","category":"animal","icon":"🐾"}},{"level":"5","type":"animal","question":"Ma magan päeval ja ärkan öösel. Mu pea saab peaaegu ringi käia, et näha. Kes ma olen?","hints":[{"text":"🐦 Olen lind."},{"text":"🌙 Mu silmad on suured ja näevad hästi pimedas."},{"text":"🔍 Ma püüan hiiri."}],"options":[{"label":"Vares","isCorrect":false},{"label":"Öökull","isCorrect":true},{"label":"Papagoi","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9C27B0","category":"animal","icon":"🐾"}}],"weather":[{"level":"1","type":"weather","question":"Ma olen taevas suur ja kuldne pall. Ma annan sulle soojust ja valgust. Kes ma olen?","hints":[{"text":"👀 Sa näed mind ainult päeval."},{"text":"🌡️ Ma panen muru kuivama."},{"text":"💡 Minu pärast on päev heledam kui öö."}],"options":[{"label":"Kuu","isCorrect":false},{"label":"Päike","isCorrect":true},{"label":"Pilv","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFF0E68C","category":"weather","icon":"🌤️"}},{"level":"2","type":"weather","question":"Ma tulen pilvedest alla, tehes maapinna märjaks. Mulle meeldib taimi kasta. Mis ma olen?","hints":[{"text":"💦 Mõnikord sa võtad minu pärast vihmavarju."},{"text":"💧 Ma teen lompe tänavatele."},{"text":"🌱 Taimed armastavad mind väga."}],"options":[{"label":"Lumi","isCorrect":false},{"label":"Udu","isCorrect":false},{"label":"Vihm","isCorrect":true}],"additionalData":{"backgroundColor":"0xFF87CEEB","category":"weather","icon":"🌤️"}},{"level":"3","type":"weather","question":"Ma ujun taevas, hall või valge, mõnikord võin tuua vihma. Näen välja nagu vatt. Mis ma olen?","hints":[{"text":"👀 Ma olen kõrgel taevas."},{"text":"🌬️ Tuul lükkab mind edasi."},{"text":"💭 Ma võin välja näha nagu puuvill."}],"options":[{"label":"Pilv","isCorrect":true},{"label":"Täht","isCorrect":false},{"label":"Lind","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFD3D3D3","category":"weather","icon":"🌤️"}},{"level":"4","type":"weather","question":"Ma olen nähtamatu, aga tunned mind. Ma panen puulehed sahisema ja juuksed lendama. Mis ma olen?","hints":[{"text":"🍃 Ma panen puu oksad liikuma."},{"text":"🪁 Minuga saab lennutada lohet."},{"text":"💨 Ma puhun sinu näole."}],"options":[{"label":"Udu","isCorrect":false},{"label":"Tuul","isCorrect":true},{"label":"Veeaur","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFA2D2FF","category":"weather","icon":"🌤️"}},{"level":"5","type":"weather","question":"Ma olen värviline kaar taevas, mis ilmub pärast vihma, kui Päike paistab. Mis ma olen?","hints":[{"text":"✨ Olen ilus ja värvikirev."},{"text":"💧 Mind näed, kui vihm on läbi ja päike paistab."},{"text":"🤔 Mõtle kaarele, mis ilmub taevasse."}],"options":[{"label":"Vikerkaar","isCorrect":true},{"label":"Äike","isCorrect":false},{"label":"Udu","isCorrect":false}],"additionalData":{"backgroundColor":"0xFFDA70D6","category":"weather","icon":"🌤️"}}]}