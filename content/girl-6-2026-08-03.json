hints":[{"text":"⬆️ Ma lendan väga-väga kõrgele."},{"text":"🔊 Minu startimine teeb palju lärmi."},{"text":"🧑‍🚀 Minuga saab reisida teistele planeetidele."}],"options":[{"label":"Lennuk","isCorrect":false},{"label":"Rakett","isCorrect":true},{"label":"Auto","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"cosmos","icon":"🌌"}},{"level":"5","type":"cosmos","question":"Ma olen suur ümmargune kodu, kus elavad kõik inimesed ja loomad. Mul on vesi ja õhk. Kes ma olen?","hints":[{"text":"🏠 Mind näeb kosmosest sinise ja rohelisena."},{"text":"🌊 Mul on palju ookeane."},{"text":"🗺️ Ma olen meie kodu universumis."}],"options":[{"label":"Kuu","isCorrect":false},{"label":"Päike","isCorrect":false},{"label":"Maa","isCorrect":true}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"cosmos","icon":"🌌"}}]}