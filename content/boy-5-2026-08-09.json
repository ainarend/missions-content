{"transport":[{"level":"1","type":"transport","question":"Mis suur sõiduk ujub vee peal ja viib inimesi üle mere?","hints":[{"text":"🌊 Sõidan vee peal."},{"text":"⚓ Mind seotakse sadamas kinni."},{"text":"👀 Mul on aknad, millest saab välja vaadata."}],"options":[{"label":"Laev","isCorrect":true},{"label":"Mootorratas","isCorrect":false},{"label":"Tramm","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"transport","icon":"🚦"}},{"level":"2","type":"transport","question":"Mul on kaks ratast nagu jalgrattal, aga saan sõita ilma väntamata. Kes ma olen?","hints":[{"text":"💨 Ma teen valju häält, kui sõidan."},{"text":"👷‍♂️ Minuga sõites peab kandma kiivrit."},{"text":"🛣️ Sõidan teedel, aga mahun kitsast kohast läbi."}],"options":[{"label":"Mootorratas","isCorrect":true},{"label":"Traktor","isCorrect":false},{"label":"Helikopter","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"transport","icon":"🚦"}},{"level":"3","type":"transport","question":"Ma sõidan mööda rööpaid, aga mitte maa all. Kogun inimesi peatuses ja viin nad edasi.","hints":[{"text":"📍 Mul on kindel tee, mida mööda sõidan."},{"text":"⚡ Saan elektrit ülevalt traatidest."},{"text":"🔔 Annan vahel kellaga märku."}],"options":[{"label":"Tramm","isCorrect":true},{"label":"Laev","isCorrect":false},{"label":"Rakett","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"transport","icon":"🚦"}},{"level":"4","type":"transport","question":"Mul on suur laba pea kohal, mis mind taevasse tõstab ja alla toob. Saan maanduda peaaegu igale poole.","hints":[{"text":"⬆️ Saan õhku tõusta otse üles."},{"text":"🌀 Mu labad pöörlevad väga kiiresti."},{"text":"☁️ Saan lennata pilvede vahel."}],"options":[{"label":"Helikopter","isCorrect":true},{"label":"Mootorratas","isCorrect":false},{"label":"Purjekas","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"transport","icon":"🚦"}},{"level":"5","type":"transport","question":"Olen pikk ja jõuline. Mind ehitatakse selleks, et viia inimesi ja asju kosmosesse.","hints":[{"text":"✨ Saan lennata väga-väga kõrgele."},{"text":"🌟 Minu eesmärk on tähtede juurde minna."},{"text":"🔥 Mul on taga suur leek, kui ma õhku tõusen."}],"options":[{"label":"Rakett","isCorrect":true},{"label":"Tramm","isCorrect":false},{"label":"Allveelaev","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"transport","icon":"🚦"}}],"food":[{"level":"1","type":"food","question":"Mis puuvili on kollane ja koorib ennast lahti nagu jope?","hints":[{"text":"💡 Mõtle puuvilja peale, mis on pikk ja kõver."},{"text":"😋 Mind on mugav käes hoida."},{"text":"💛 Minu värv on kollane."}],"options":[{"label":"Pirn","isCorrect":false},{"label":"Banaan","isCorrect":true},{"label":"Maasikas","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"food","icon":"🍽️"}},{"level":"2","type":"food","question":"Ma olen valge ja saad mind lehma käest. Lapsed joovad mind, et suureks kasvada. Mis ma olen?","hints":[{"text":"🧊 Mind hoitakse külmkapis."},{"text":"🧐 Mind annab lehm."},{"text":"⚪️ Ma olen valget värvi."}],"options":[{"label":"Vesi","isCorrect":false},{"label":"Piim","isCorrect":true},{"label":"Limonaad","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"food","icon":"🍽️"}},{"level":"3","type":"food","question":"Ma olen oranž ja krõmpsuv. Jänesed armastavad mind ja ma kasvan maa sees. Kes ma olen?","hints":[{"text":"💭 Mõtle köögiviljale, mis on pikk ja kitsas."},{"text":"🐾 Jänesed söövad mind meelsasti."},{"text":"🌱 Mind kasvatatakse maa all."}],"options":[{"label":"Kartul","isCorrect":false},{"label":"Porgand","isCorrect":true},{"label":"Kapsas","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"food","icon":"🍽️"}},{"level":"4","type":"food","question":"Mind küpsetatakse ahjus ja ma teen sinu kõhu täis. Minust saab võileiba teha. Mis ma olen?","hints":[{"text":"😋 Mind on hea soojalt süüa."},{"text":"🌾 Mind tehakse jahust."},{"text":"🤔 Minuga saab teha võileibu."}],"options":[{"label":"Pirukas","isCorrect":false},{"label":"Leib","isCorrect":true},{"label":"Küpsis","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"food","icon":"🍽️"}},{"level":"5","type":"food","question":"Olen tavaliselt kollane ja mul on mõnikord augud sees. Mul on hea maitse, eriti võileiva peal. Kes ma olen?","hints":[{"text":"🧐 Mind hoitakse külmkapis."},{"text":"🤔 Hiirtele meeldib mind süüa."},{"text":"💛 Olen tavaliselt kollast värvi."}],"options":[{"label":"Või","isCorrect":false},{"label":"Juust","isCorrect":true},{"label":"Singiviil","isCorrect":false}],"additionalData":{"backgroundColor":"0xFF9370DB","category":"food","icon":"🍽️"}}]}